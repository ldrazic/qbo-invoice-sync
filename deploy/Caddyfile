# Automatic HTTPS: Caddy obtains and renews a Let's Encrypt certificate for
# PUBLIC_HOST (a sslip.io name resolving to this VM's IP — no DNS needed).
{$PUBLIC_HOST} {
	reverse_proxy app:3000

	# Generate the hash with:  docker run --rm caddy:2-alpine caddy hash-password --plaintext 'yourpass'
	# Keep /webhooks/* and /qbo/* open: Intuit calls them (webhooks are HMAC-verified).
	#
	# @protected path /internal/* /admin/*
	# basic_auth @protected {
	# 	demo <paste-hash-here>
	# }
}
