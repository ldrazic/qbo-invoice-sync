PORT=3000
DATABASE_URL=postgres://sync:sync@localhost:5433/invoice_sync

# "quickbooks" | "fake" (in-memory provider, no QBO account needed)
ACCOUNTING_PROVIDER=quickbooks

QBO_CLIENT_ID=your-intuit-app-client-id
QBO_CLIENT_SECRET=your-intuit-app-client-secret
# Must match a Redirect URI configured in the Intuit app settings:
QBO_REDIRECT_URI=http://localhost:3000/qbo/callback
QBO_WEBHOOK_VERIFIER_TOKEN=your-webhook-verifier-token
# "sandbox" | "production"
QBO_ENVIRONMENT=sandbox

SYNC_POLL_INTERVAL_MS=1000
SYNC_MAX_ATTEMPTS=8

# --- webhook switch (deploy/webhook-switch, deployed VM only) ---------------
# Re-points /webhooks/* at a dev tunnel without changing the endpoint URL
# registered with Intuit. The control API is publicly reachable, so the service
# refuses to start unless this token is set (>= 16 chars, generate a random one):
SWITCH_ADMIN_TOKEN=replace-with-a-long-random-secret
# Where "forward"/"both" send deliveries (an ngrok/cloudflared tunnel to your
# machine). Also settable at runtime from /_switch; the runtime value wins.
SWITCH_TARGET_URL=https://your-tunnel.example.invalid
# Startup default only — the persisted state file wins after the first change.
# "local" (VM app) | "forward" (tunnel) | "both"
SWITCH_MODE=local
