{
  "name": "invoice-sync",
  "version": "0.1.0",
  "description": "Two-way invoice sync between an internal invoicing system and QuickBooks Online",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "migrate": "tsx src/models/db/migrate.ts",
    "seed": "tsx src/models/db/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "deploy": "bash scripts/deploy.sh push",
    "deploy:dry": "bash scripts/deploy.sh push --dry-run",
    "deploy:status": "bash scripts/deploy.sh status",
    "deploy:logs": "bash scripts/deploy.sh logs",
    "deploy:restart": "bash scripts/deploy.sh restart",
    "deploy:seed": "bash scripts/deploy.sh seed",
    "deploy:ssh": "bash scripts/deploy.sh ssh",
    "deploy:exec": "bash scripts/deploy.sh exec --",
    "deploy:script": "bash scripts/deploy.sh script --",
    "deploy:health": "bash scripts/deploy.sh health",
    "webhook:fake": "bash scripts/fake-webhook.sh",
    "deploy:env:pull": "bash scripts/deploy.sh env:pull",
    "deploy:env:push": "bash scripts/deploy.sh env:push"
  },
  "dependencies": {
    "fastify": "^5.2.0",
    "kysely": "^0.27.5",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
