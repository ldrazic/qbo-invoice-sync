# Config for scripts/deploy.sh — copy to .deploy.env (gitignored) and fill in.
#
#     cp deploy.env.example .deploy.env
#
# This repo is PUBLIC: the real droplet IP / hostname must never be committed.
# Every value can also be supplied as an environment variable, which wins over
# this file (e.g. `DEPLOY_HOST=203.0.113.10 scripts/deploy.sh status`).

# Droplet IP or hostname. Required — the script refuses to run without it.
DEPLOY_HOST=203.0.113.10

# SSH user on the droplet.
DEPLOY_USER=root

# App directory on the droplet (where docker-compose.prod.yml lives).
DEPLOY_PATH=/opt/invoice-sync

# Public HTTPS hostname used for /health and the demo URLs. Optional: if
# DEPLOY_HOST is an IPv4 address this is derived as <ip-with-dashes>.sslip.io,
# which is what DEPLOY.md sets up.
PUBLIC_HOST=203-0-113-10.sslip.io

# Optional SSH details. Set DEPLOY_SSH_KEY when the droplet does not accept
# your default key ("Permission denied (publickey)"); leave it unset to let
# ssh use ~/.ssh/config.
#DEPLOY_SSH_KEY=~/.ssh/id_droplet
#DEPLOY_SSH_PORT=22

# Optional: compose file to use on the VM.
#DEPLOY_COMPOSE_FILE=docker-compose.prod.yml
